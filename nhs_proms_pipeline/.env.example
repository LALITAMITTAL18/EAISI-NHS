# .env.example — copy to .env and fill in your values
# Do NOT commit .env to version control

# ── Data paths ────────────────────────────────────────────────────────────────
# Root directory where raw NHS PROMs CSV files are stored
RAW_DATA_DIR=../data/external

# Directory for intermediate parquet files
INTERIM_DATA_DIR=./data/interim

# Directory where trained models are persisted
MODELS_DIR=./models

# Directory for evaluation reports / charts
REPORTS_DIR=./reports

# ── Pipeline defaults ─────────────────────────────────────────────────────────
# Procedure type: KNEE or HIP
PROCEDURE_TYPE=KNEE

# Random seed for reproducibility
RANDOM_SEED=42

# Train / test split ratio (0.0 – 1.0)
TRAIN_TEST_RATIO=0.8

# ── Model training ─────────────────────────────────────────────────────────────
# Number of CV folds
CV_SPLITS=5

# Number of CV repeats
CV_REPEATS=3

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
