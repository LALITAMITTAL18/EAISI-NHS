# ── MLPortal environment variables ───────────────────────────────────────────
# Copy this file to .env and fill in your values.
# The app loads these automatically if you launch with:
#   python -m streamlit run Home.py  (and python-dotenv is installed)
# Or set them in your shell before running.

# ── Azure Subscription (Stage 9 — Clinical Insight) ──────────────────────────
# Find your subscription ID at: Azure Portal → Subscriptions
AZURE_SUBSCRIPTION_ID=your-subscription-id-here

# ── Azure OpenAI / GPT-4o via AI Foundry (Stage 9 — Clinical Insight) ────────
# Endpoint for your AI Foundry deployment
AZURE_OPENAI_ENDPOINT=https://AIFoundryHRPolicies.services.ai.azure.com/openai/v1

# GPT-4o deployment name in AI Foundry
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# API key — get from AI Foundry portal → Keys and Endpoint
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
